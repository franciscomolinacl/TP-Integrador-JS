{{> header}}

<main class="container my-5 flex-grow-1 d-flex align-items-center justify-content-center">
  <div class="row justify-content-center w-100">
    <div class="col-md-9 col-lg-7 text-center">
      
      <!-- Contenedor del Icono/Código Visual -->
      <div class="mb-4 position-relative d-inline-block">
        <!-- Número de error gigante difuminado de fondo -->
        <span class="display-1 fw-black text-secondary opacity-10 position-absolute top-50 start-50 translate-middle font-monospace" style="font-size: 7rem; z-index: 0;">
          {{statusCode}}
        </span>
        <!-- Ícono principal -->
        <div class="bg-danger-subtle text-danger rounded-circle p-4 d-flex align-items-center justify-content-center mx-auto position-relative" style="width: 90px; height: 90px; z-index: 1;">
          <i class="bi bi-exclamation-triangle-fill display-5"></i>
        </div>
      </div>

      <!-- Textos Informativos -->
      <h1 class="display-6 fw-bold text-dark mb-2">{{titulo}}</h1>
      <p class="lead text-muted px-md-5 mb-4">{{mensaje}}</p>

      <!-- Bloque de Detalles Técnicos (Se muestra solo si existen detalles) -->
      {{#if detalles}}
        <div class="card border-0 bg-dark text-start rounded-4 shadow-sm mb-4 overflow-hidden">
          <div class="card-header bg-secondary bg-opacity-10 border-0 py-2 px-3 d-flex align-items-center justify-content-between">
            <span class="text-uppercase tracking-wider font-monospace text-muted small fw-bold">
              <i class="bi bi-terminal me-1"></i> Detalles del Stack Trace
            </span>
            <span class="badge bg-danger bg-opacity-25 text-danger font-monospace small">Status {{statusCode}}</span>
          </div>
          <div class="card-body p-3">
            <pre class="m-0 text-success-subtle font-monospace small overflow-x-auto" style="max-height: 250px; line-height: 1.5;">{{detalles}}</pre>
          </div>
        </div>
      {{/if}}

      <!-- Botón de Acción de Regreso -->
      <div class="pt-2">
        <a href="/" class="btn btn-dark px-4 py-2 rounded-3 fw-medium shadow-sm d-inline-flex align-items-center gap-2 transition-base">
          <i class="bi bi-house-door-fill"></i> Volver al inicio
        </a>
      </div>

    </div>
  </div>
</main>


{{> footer}}