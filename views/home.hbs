{{> header}}

<main class="container my-5 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-lg-9">

      <div class="bg-white p-5 rounded-4 shadow-sm mb-5 border border-light">
        <h1 class="display-5 fw-bold text-gradient mb-3">{{titulo}}</h1>
        <p class="lead text-muted lh-lg mb-0">{{mensaje}}</p>
      </div>

      <section class="mb-4">
        <div class="d-flex align-items-center mb-4">
          <div class="bg-dark text-white p-2 rounded-3 me-3 d-flex align-items-center justify-content-center"
            style="width: 40px; height: 40px;">
            <i class="bi bi-cpu-fill fs-5"></i>
          </div>
          <h2 class="h4 fw-bold m-0 text-secondary text-uppercase tracking-wider">Tecnologías</h2>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-3">
          {{#each tecnologias}}
          <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-3 bg-white transition-hover">
              <div class="card-body d-flex align-items-center p-3">
                <span class="badge bg-dark-subtle text-dark rounded-circle p-2 me-3">
                  <i class="bi bi-check-circle-fill text-dark fs-6"></i>
                </span>
                <span class="fw-semibold text-dark fs-5">{{this}}</span>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      </section>

    </div>
  </div>
</main>

{{> footer}}