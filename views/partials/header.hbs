<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{titulo}}</title>
  <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/estilos.css">
  <script src="/js/app.js" defer></script>
</head>

<body class="d-flex flex-column min-vh-100 bg-light text-dark">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/img/logo.png" class="logo me-2" alt="Logo Node.js" style="height: 40px; width: auto;">
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 me-4 align-items-lg-center">
        
        <li class="nav-item mx-1">
          <a class="nav-link active fw-medium d-flex align-items-center" aria-current="page" href="/">
            <i class="bi bi-house-door me-2"></i> Inicio
          </a>
        </li>

        {{#if usuario}}
        <li class="nav-item mx-1 dropdown">
          <a class="nav-link dropdown-toggle text-white-50 fw-medium d-flex align-items-center" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-gear me-2"></i> Usuarios
          </a>
          <ul class="dropdown-menu dropdown-menu-dark border-0 shadow rounded-3" aria-labelledby="navbarDropdownMenuLink">
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/usuarios/nuevo">
                <i class="bi bi-person-plus me-2"></i> Crear usuario
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/usuarios/registro-completo">
                <i class="bi bi-person-plus me-2"></i> Registro completo
              </a>
            </li>            
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/usuarios">
                <i class="bi bi-people me-2"></i> Ver todos
              </a>
            </li>
          </ul>
        </li>
  
        <li class="nav-item mx-1 dropdown">
          <a class="nav-link dropdown-toggle text-white-50 fw-medium d-flex align-items-center" href="#" id="navbarDropdownPedidos" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-bag me-2"></i> Pedidos
          </a>
          <ul class="dropdown-menu dropdown-menu-dark border-0 shadow rounded-3" aria-labelledby="navbarDropdownPedidos">
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/pedidos/nuevo">
                <i class="bi bi-bag-plus me-2"></i> Nuevo pedido
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/pedidos">
                <i class="bi bi-bag-check me-2"></i> Ver todos
              </a>
            </li>
          </ul>
        </li>
        {{/if}}

        <li class="nav-item mx-1">
          <a class="nav-link text-white-50 fw-medium d-flex align-items-center" href="/status">
            <i class="bi bi-activity me-2"></i> Estado
          </a>
        </li>

        <li class="nav-item mx-1">
          <a class="nav-link text-white-50 fw-medium d-flex align-items-center" href="/api/usuarios">
            <i class="bi bi-braces me-2"></i> API
          </a>
        </li>

        {{#if usuario}}
        <li class="nav-item mx-1 dropdown">
          <a class="nav-link dropdown-toggle text-white-50 fw-medium d-flex align-items-center" href="#" id="navbarDropdownUsuario" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            {{#if usuario.avatar}}
              <img src="/uploads/{{usuario.avatar}}" alt="Avatar" class="rounded-circle me-2" style="width: 24px; height: 24px; object-fit: cover;">
            {{else}}
              <i class="bi bi-person-circle me-2"></i>
            {{/if}}
            {{usuario.correo}}
          </a>
          <ul class="dropdown-menu dropdown-menu-dark border-0 shadow rounded-3" aria-labelledby="navbarDropdownUsuario">
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center" href="/usuarios/{{usuario.id}}/perfil">
                <i class="bi bi-person me-2"></i> Mi perfil
              </a>
            </li>
            <li>
              <form method="POST" action="/logout" class="d-inline">
                <button type="submit" class="dropdown-item py-2 d-flex align-items-center border-0 bg-transparent w-100">
                  <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                </button>
              </form>
            </li>
          </ul>
        </li>
        {{else}}
        <li class="nav-item mx-1">
          <a class="nav-link text-white-50 fw-medium d-flex align-items-center" href="/login">
            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar sesión
          </a>
        </li>
        <li class="nav-item mx-1">
          <a class="nav-link text-white-50 fw-medium d-flex align-items-center" href="/registro">
            <i class="bi bi-person-plus me-2"></i> Registrarse
          </a>
        </li>
        {{/if}}
      </ul>

      {{#if usuario}}
      <form class="d-flex" role="search" method="get" action="/usuarios">
        <div class="input-group">
          <input id="nombre" name="nombre" class="form-control bg-secondary text-white border-0 opacity-75" type="search"
            placeholder="Buscar usuario por nombre..." aria-label="Search">
          <button class="btn btn-outline-light" type="submit"><i class="bi bi-search"></i></button>
        </div>
      </form>
      {{/if}}
    </div>
  </div>
</nav>
