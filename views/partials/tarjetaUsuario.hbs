<article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white transition-hover">

  <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
    <span class="text-uppercase text-muted fw-bold font-monospace small tracking-wider">
      <i class="bi bi-hash small"></i>Usuario {{sumarUno @index}}
    </span>

    {{#if activo}}
    <span class="badge text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold small">
      <i class="bi bi-circle-fill me-1 small"></i> Activo
    </span>
    {{else}}
    <span class="badge text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-semibold small">
      <i class="bi bi-circle-fill me-1 small"></i> Inactivo
    </span>
    {{/if}}
  </div>

  <div class="card-body px-4 pb-3">
    <h2 class="h5 card-title fw-bold text-dark mb-1 tracking-tight text-truncate">
      {{nombre}}
    </h2>
    <p class="card-text text-muted small d-flex align-items-center gap-2 mb-0 text-truncate">
      <i class="bi bi-envelope text-secondary opacity-75"></i> {{correo}}
    </p>
  </div>

  <div class="card-footer bg-transparent border-0 pt-0 px-4 pb-4 mt-auto">
    <a href="/usuarios/{{id}}"
      class="btn btn-outline-dark btn-sm w-100 rounded-3 fw-medium d-flex align-items-center 
      justify-content-center gap-1 shadow-sm-hover transition-base text-dark link-light">
      Ver detalle completo <i class="bi bi-chevron-right small"></i>
    </a>

    <a class="btn btn-outline-warning btn-sm w-100 rounded-3 fw-medium d-flex align-items-center 
      justify-content-center my-2 gap-1 shadow-sm-hover transition-base text-warning link-light" 
      href="/usuarios/{{id}}/editar">
      Editar
    </a>

    <form id="formEliminar-{{id}}" method="POST" action="/usuarios/{{id}}/eliminar">
      <button 
        class="btn btn-outline-danger btn-sm w-100 rounded-3 fw-medium d-flex align-items-center 
          justify-content-center my-2 gap-1 shadow-sm-hover transition-base text-danger link-light" 
        type="button" 
        data-bs-toggle="modal" 
        data-bs-target="#modalEliminar-{{id}}">
        Eliminar
      </button>
    </form>
  </div>

  <div class="modal fade" id="modalEliminar-{{id}}" tabindex="-1" aria-labelledby="modalEliminarLabel-{{id}}" 
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-3 shadow">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-bold text-dark" id="modalEliminarLabel-{{id}}">¿Eliminar a {{nombre}}?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-0 text-muted">
          Esta acción no se puede deshacer. ¿Realmente deseas eliminar esta entrada?
        </div>
        <div class="modal-footer border-0 row g-2">
          <div class="col">
            <button type="button" class="btn btn-light w-100 rounded-3 fw-medium" data-bs-dismiss="modal">
              Cancelar
            </button>
          </div>
          <div class="col">
            <button type="submit" form="formEliminar-{{id}}" class="btn btn-danger w-100 rounded-3 fw-medium">
              Eliminar permanentemente
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</article>
