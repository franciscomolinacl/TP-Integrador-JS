{{> header}}

<main class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">

                        <div class="position-relative d-inline-block" style="width: 48px; height: 48px;">
                            <span class="position-absolute bg-success rounded-circle animate-ping"></span>

                            <span
                                class="position-relative p-2.5 bg-success text-white rounded-circle d-flex align-items-center justify-content-center"
                                style="width: 100%; height: 100%;">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                            </span>
                        </div>

                        <div>
                            <h1 class="h4 fw-bold m-0 text-dark">{{titulo}}</h1>
                            <p class="text-muted small m-0">{{message}}</p>
                        </div>
                    </div>
                    <span
                        class="badge bg-success text-uppercase px-3 py-2 rounded-pill fw-bold tracking-wide shadow-sm">
                        Online
                    </span>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                        <div class="text-secondary fw-semibold small text-uppercase tracking-wider mb-2">
                            <i class="bi bi-globe me-2 text-primary"></i>Entorno de ejecución
                        </div>
                        <div class="fs-4 fw-bold text-dark">{{info.environment}}</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                        <div class="text-secondary fw-semibold small text-uppercase tracking-wider mb-2">
                            <i class="bi bi-clock-history me-2 text-warning"></i>Tiempo Activo (Uptime)
                        </div>
                        <div class="fs-4 fw-bold text-dark font-monospace">{{info.uptime}}</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                        <div class="text-secondary fw-semibold small text-uppercase tracking-wider mb-2">
                            <i class="bi bi-box-seam me-2 text-success"></i>Node.js
                        </div>
                        <div class="fs-5 fw-bold text-secondary font-monospace">{{info.node}}</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                        <div class="text-secondary fw-semibold small text-uppercase tracking-wider mb-2">
                            <i class="bi bi-terminal me-2 text-danger"></i>ID de Proceso (PID)
                        </div>
                        <div class="fs-5 fw-bold text-secondary font-monospace">#{{info.pid}}</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                        <div class="text-secondary fw-semibold small text-uppercase tracking-wider mb-2">
                            <i class="bi bi-calendar3 me-2 text-info"></i>Hora Registro
                        </div>
                        <div class="fs-5 fw-bold text-secondary font-monospace">{{info.requestTime}}</div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</main>

{{> footer}}