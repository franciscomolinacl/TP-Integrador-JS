{{> header}}

<main class="container my-5 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="mb-4">
        <a href="/usuarios/{{usuario.id}}/perfil"
          class="btn btn-link link-secondary p-0 text-decoration-none d-inline-flex align-items-center gap-2 fw-medium link-hover">
          <i class="bi bi-arrow-left fs-5"></i> Volver al perfil
        </a>
      </div>

      <div class="mb-4">
        <h1 class="display-6 fw-bold text-dark m-0">{{titulo}}</h1>
        <p class="text-muted m-0 mt-1">Perfil de <strong>{{usuario.nombre}}</strong></p>
      </div>

      {{#if error}}
        <div class="alert alert-danger d-flex align-items-center border-0 shadow-sm rounded-4 mb-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
          <div>
            <strong class="d-block">No fue posible guardar el perfil:</strong>
            <span class="small">{{error}}</span>
          </div>
        </div>
      {{/if}}

      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form method="POST" action="/usuarios/{{usuario.id}}/perfil/editar" class="needs-validation" novalidate>
          
          <div class="mb-4">
            <label for="telefono" class="form-label text-secondary fw-semibold small text-uppercase tracking-wider">
              <i class="bi bi-telephone me-1"></i> Teléfono
            </label>
            <input 
              id="telefono" 
              name="telefono" 
              type="tel" 
              class="form-control bg-light border-light py-2"
              placeholder="Ej: +56 9 1234 5678"
              value="{{valores.telefono}}"
            >
          </div>

          <div class="mb-4">
            <label for="direccion" class="form-label text-secondary fw-semibold small text-uppercase tracking-wider">
              <i class="bi bi-geo-alt me-1"></i> Dirección
            </label>
            <input 
              id="direccion" 
              name="direccion" 
              type="text" 
              class="form-control bg-light border-light py-2"
              placeholder="Ej: Av. Providencia 1234, Santiago"
              value="{{valores.direccion}}"
            >
          </div>

          <div class="mb-5">
            <label for="fechaNacimiento" class="form-label text-secondary fw-semibold small text-uppercase tracking-wider">
              <i class="bi bi-calendar3 me-1"></i> Fecha de nacimiento
            </label>
            <input 
              id="fechaNacimiento" 
              name="fechaNacimiento" 
              type="date" 
              class="form-control bg-light border-light py-2"
              value="{{valores.fechaNacimiento}}"
            >
          </div>

          <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 border-top pt-4">
            <a href="/usuarios/{{usuario.id}}/perfil" class="btn btn-light border-light text-secondary rounded-pill px-4 py-2 order-2 order-sm-1">
              <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-dark rounded-pill px-4 py-2 order-1 order-sm-2 shadow-sm">
              <i class="bi bi-check-circle-fill me-1"></i> Guardar perfil
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</main>

{{> footer}}